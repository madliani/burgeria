---
import AbstractBloc from "@pages/components/abstract-bloc.astro"
import AbstractButton from "@pages/components/abstract-button.astro"
import AbstractHeader from "@pages/components/abstract-header.astro"
import AbstractLocalLink from "@pages/components/abstract-local-link.astro"
import AbstractLogo from "@pages/components/abstract-logo.astro"
import AbstractMenuItem from "@pages/components/abstract-menu-item.astro"
import AbstractMenu from "@pages/components/abstract-menu.astro"
import AbstractNavbar from "@pages/components/abstract-navbar.astro"
import AbstractTextDecoration from "@pages/components/abstract-text-decoration.astro"

interface MenuItem {
    name: string
    url: string
}

const menuItems: readonly MenuItem[] = [{ name: "Home", url: "/" }]
---

<AbstractHeader className="base-header">
    <AbstractBloc className="base-header__logo-container">
        <AbstractLocalLink href="/">
            <AbstractLogo
                alt="Burgeria logo"
                className="base-header__logo"
                src="/icons/burgeria-logo.png"
            /></AbstractLocalLink
        >
    </AbstractBloc>

    <AbstractNavbar className="base-header__navbar">
        <AbstractMenu className="base-header__menu">
            {
                menuItems.map(({ name, url }) => (
                    <AbstractMenuItem className="base-header__menu-item">
                        <AbstractLocalLink href={url}>{name}</AbstractLocalLink>
                    </AbstractMenuItem>
                ))
            }
        </AbstractMenu>

        <AbstractButton
            className="base-header__hamburger hamburger hamburger--default"
            id="hamburger"
            type="button"
        >
            <AbstractBloc className="inner">
                <AbstractTextDecoration className="bar" />

                <AbstractTextDecoration className="bar" />

                <AbstractTextDecoration className="bar" />
            </AbstractBloc>
        </AbstractButton>

        <AbstractMenu className="base-header__mobile-menu" id="mobile-menu">
            {
                menuItems.map(({ name, url }) => (
                    <AbstractMenuItem className="base-header__mobile-menu-item">
                        <AbstractLocalLink href={url}>{name}</AbstractLocalLink>
                    </AbstractMenuItem>
                ))
            }
        </AbstractMenu>
    </AbstractNavbar>
</AbstractHeader>
