---
import AbstractBloc from "@pages/components/abstract-bloc.astro"
import AbstractFooter from "@pages/components/abstract-footer.astro"
import AbstractGlobalLink from "@pages/components/abstract-global-link.astro"
import AbstractIcon from "@pages/components/abstract-icon.astro"
import AbstractParagraph from "@pages/components/abstract-paragraph.astro"
---

<AbstractFooter className="footer">
    <AbstractParagraph className="footer__legal-notice"
        >Copyright © {new Date().getUTCFullYear()}{" "}
        Madliani Studio. All Rights Reserved.</AbstractParagraph
    >

    <AbstractBloc className="footer__social-link-group">
        <AbstractGlobalLink href="https://facebook.com/" title="Facebook link"
            ><AbstractIcon
                className="fa-brands fa-facebook"
            /></AbstractGlobalLink
        >
        <AbstractGlobalLink href="https://instagram.com/" title="Instagram link"
            ><AbstractIcon
                className="fa-brands fa-instagram"
            /></AbstractGlobalLink
        >
        <AbstractGlobalLink href="https://tiktok.com/" title="TikTok link"
            ><AbstractIcon
                className="fa-brands fa-tiktok"
            /></AbstractGlobalLink
        >
    </AbstractBloc>

    <AbstractBloc className="footer__noscript">
        <slot name="noscript" />
    </AbstractBloc>
</AbstractFooter>
