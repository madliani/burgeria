---
import AbstractButton from "@pages/components/abstract-button.astro"
import AbstractLocalLink from "@pages/components/abstract-local-link.astro"
import AbstractSection from "@pages/components/abstract-section.astro"
import AbstractSubtitle from "@pages/components/abstract-subtitle.astro"
import AbstractTitle from "@pages/components/abstract-title.astro"
---

<AbstractSection className="home-hero">
    <AbstractTitle className="home-hero__title">
        Welcome to Burgeria
    </AbstractTitle>

    <AbstractSubtitle className="home-hero__subtitle">
        The Fast Food Company
    </AbstractSubtitle>

    <AbstractLocalLink href="/">
        <AbstractButton className="home-hero__button" title="View menu">
            View button
        </AbstractButton></AbstractLocalLink
    >
</AbstractSection>
