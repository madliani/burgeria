---
import { parseDataAttrs } from "@pages/components/utilities/property-utilities"

interface Props {
    className?: string
    dataset?: DOMStringMap
    href: string
    id?: string
    newTab?: boolean
    title?: string
}

const { className, dataset, href, id, newTab = false, title } = Astro.props
---

{
    newTab ? (
        <a
            aria-label={title}
            class={className}
            href={href}
            id={id}
            target="_blank"
            title={title}
            {...parseDataAttrs(dataset)}
        >
            <slot />
        </a>
    ) : (
        <a
            aria-label={title}
            class={className}
            href={href}
            id={id}
            title={title}
            {...parseDataAttrs(dataset)}
        >
            <slot />
        </a>
    )
}
