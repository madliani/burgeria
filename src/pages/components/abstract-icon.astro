---
import { parseDataAttrs } from "@pages/components/utilities/property-utilities"

interface Props {
    className: string
    dataset?: DOMStringMap
    title?: string
}

const { className, dataset, title } = Astro.props
---

<i
    aria-label={title}
    class={className}
    title={title}
    {...parseDataAttrs(dataset)}></i>
