---
type ButtonTypeAttr = "button" | "reset" | "submit"

interface Props {
    className?: string
    id?: string
    title?: string
    type?: ButtonTypeAttr
}

const { className, id, title, type } = Astro.props
---

<button aria-label={title} class={className} id={id} title={title} type={type}>
    <slot />
</button>
