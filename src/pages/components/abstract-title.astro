---
import { parseDataAttrs } from "@pages/components/utilities/property-utilities"

interface Props {
    className?: string
    dataset?: DOMStringMap
    id?: string
    title?: string
}

const { className, dataset, id, title } = Astro.props
---

<h1
    aria-label={title}
    class={className}
    id={id}
    title={title}
    {...parseDataAttrs(dataset)}
>
    <slot />
</h1>
