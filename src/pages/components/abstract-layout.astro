---
import { parseDataAttrs } from "@pages/components/utilities/property-utilities"

interface Props {
    className?: string
    dataset?: DOMStringMap
    id?: string
    lang?: string
}

const { className, dataset, id, lang } = Astro.props
---

<!doctype html>
<html lang={lang}>
    <head>
        <slot name="head" />
    </head>

    <body class={className} id={id} {...parseDataAttrs(dataset)}>
        <slot />
    </body></html
>
