---
import { parseDataAttrs } from "@pages/components/utilities/property-utilities"

interface Props {
    className?: string
    dataset?: DOMStringMap
    id?: string
}

const { className, dataset, id } = Astro.props
---

<footer
    class={className}
    id={id}
    {...parseDataAttrs(dataset)}
    role="contentinfo"
>
    <slot />
</footer>
