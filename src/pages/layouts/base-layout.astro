---
import MetadataConfig from "@configurations/metadata.config.json"
import BaseFooter from "@pages/blocs/base-footer.astro"
import BaseHeader from "@pages/blocs/base-header.astro"
import BaseNoscript from "@pages/blocs/base-noscript.astro"
import AbstractLayout from "@pages/components/abstract-layout.astro"
import AbstractMain from "@pages/components/abstract-main.astro"
import AbstractMetadata from "@pages/components/abstract-metadata.astro"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props
---

<AbstractLayout className="base-layout" lang={MetadataConfig.language}>
    <Fragment slot="head">
        <AbstractMetadata description={description} title={title} />

        <ClientRouter />
    </Fragment>

    <BaseHeader />

    <AbstractMain className="base-layout__main">
        <BaseNoscript />

        <slot />
    </AbstractMain>

    <BaseFooter />
</AbstractLayout>
