---
import { parseDataAttrs } from "@components/utils/property-utils"

interface Props {
    alt: string
    className?: string
    dataset?: DOMStringMap
    id?: string
    src: string
}

const { alt, className, dataset, id, src } = Astro.props
---

<img
    alt={alt}
    aria-label={alt}
    class={className}
    id={id}
    src={src}
    title={alt}
    {...parseDataAttrs(dataset)}
/>
