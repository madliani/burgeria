---
import { parseDataAttrs } from "@components/utils/property-utils"

interface Props {
    className?: string
    dataset?: DOMStringMap
    id?: string
    title?: string
}

const { className, dataset, id, title } = Astro.props
---

<li
    aria-label={title}
    class={className}
    id={id}
    title={title}
    {...parseDataAttrs(dataset)}
>
    <slot />
</li>
