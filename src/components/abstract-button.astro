---
import { parseDataAttrs } from "@components/utils/property-utils"

interface Props {
    className?: string
    dataset?: DOMStringMap
    id?: string
    title?: string
    type?: HTMLButtonElement["type"]
}

const { className, dataset, id, title, type } = Astro.props
---

<button
    aria-label={title}
    class={className}
    id={id}
    title={title}
    type={type}
    {...parseDataAttrs(dataset)}
>
    <slot />
</button>
