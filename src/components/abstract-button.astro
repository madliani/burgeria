---
interface Props {
    className?: string
    href?: string
    id?: string
    title: string
}

const { className, href, id, title } = Astro.props
---

{
    typeof href === "string" ? (
        <a href={href}>
            <button aria-label={title} class={className} id={id} title={title}>
                <slot />
            </button>
        </a>
    ) : (
        <button aria-label={title} class={className} id={id} title={title}>
            <slot />
        </button>
    )
}
