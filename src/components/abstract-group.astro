---
import { parseDataAttrs } from "@components/utilities/property-utilities"

interface Props {
    className?: string
    dataset?: DOMStringMap
    id?: string
    title?: string
}

const { className, dataset, title } = Astro.props
---

<div
    aria-label={title}
    class={className}
    title={title}
    {...parseDataAttrs(dataset)}
>
    <slot />
</div>
