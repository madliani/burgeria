---
import { parseDataAttrs } from "@components/utilities/property-utilities"

interface Props {
    className?: string
    dataset?: DOMStringMap
    id?: string
    title?: string
}

const { className, dataset, id, title } = Astro.props
---

<section
    aria-label={title}
    class={className}
    id={id}
    title={title}
    {...parseDataAttrs(dataset)}
>
    <slot />
</section>
