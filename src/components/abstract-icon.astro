---
import { parseDataAttrs } from "@components/utils/property-utils"

interface Props {
    className: string
    dataset?: DOMStringMap
    id?: string
    title?: string
}

const { className, dataset, id, title } = Astro.props
---

<i
    aria-label={title}
    class={className}
    id={id}
    title={title}
    {...parseDataAttrs(dataset)}></i>
