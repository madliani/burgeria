---
interface Props {
    className?: string
    lang?: string
}

const { className, lang } = Astro.props
---

<!doctype html>
<html lang={lang}>
    <head>
        <slot name="head" />
    </head>

    <body class={className}>
        <slot name="header" />

        <slot name="left-sidebar" />

        <slot />

        <slot name="footer" />
    </body></html
>
