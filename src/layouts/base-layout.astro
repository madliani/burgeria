---
import Metadata from "@blocs/metadata.astro"
import AbstractBloc from "@components/abstract-bloc.astro"
import AbstractFooter from "@components/abstract-footer.astro"
import AbstractGlobalLink from "@components/abstract-global-link.astro"
import AbstractHeader from "@components/abstract-header.astro"
import AbstractLayout from "@components/abstract-layout.astro"
import AbstractLocalLink from "@components/abstract-local-link.astro"
import AbstractLogo from "@components/abstract-logo.astro"
import "@styles/global.tw.css"
import AbstractMain from "@components/abstract-main.astro"
import AbstractMenuItem from "@components/abstract-menu-item.astro"
import AbstractMenu from "@components/abstract-menu.astro"
import AbstractNavbar from "@components/abstract-navbar.astro"
import AbstractNoscript from "@components/abstract-noscript.astro"
import AbstractParagraph from "@components/abstract-paragraph.astro"
import AbstractTextDecoration from "@components/abstract-text-decoration.astro"
import MetadataConfig from "@configurations/metadata.config.json"
import { ClientRouter } from "astro:transitions"

interface MenuItem {
    name: string
    url: string
}

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props

const menuItems: readonly MenuItem[] = [
    { name: "Home", url: "/" },
    { name: "Menu", url: "/" }
]
---

<AbstractLayout className="layout" lang={MetadataConfig.language}>
    <Fragment slot="head">
        <Metadata description={description} title={title} />

        <ClientRouter />
    </Fragment>

    <AbstractHeader className="header">
        <AbstractLocalLink href="/">
            <AbstractLogo
                alt="Burgeria logo"
                src="/icons/burgeria-logo.png"
            /></AbstractLocalLink
        >

        <AbstractNavbar
            className="flex w-full flex-row flex-nowrap items-center justify-end align-middle text-xl"
        >
            <AbstractMenu
                className="hidden sm:flex sm:flex-row sm:flex-nowrap sm:items-center sm:justify-evenly sm:gap-7 sm:align-middle"
            >
                {
                    menuItems.map(({ name, url }) => (
                        <AbstractMenuItem className="cursor-pointer hover:underline">
                            <AbstractLocalLink href={url}>
                                {name}
                            </AbstractLocalLink>
                        </AbstractMenuItem>
                    ))
                }
            </AbstractMenu>

            <AbstractBloc
                className="tham-w-6 tham-e-squeeze z-10 tham sm:hidden"
                id="hamburger"
            >
                <AbstractBloc className="tham-box">
                    <AbstractBloc className="tham-inner" />
                </AbstractBloc>
            </AbstractBloc>

            <AbstractMenu
                className="absolute top-0 right-0 bottom-0 left-0 hidden w-full flex-col flex-nowrap items-start justify-start gap-3 bg-white bg-[url('/images/prebuiltui-gradient-background.svg')] bg-cover px-3 py-5 align-middle"
                id="mobile-menu"
            >
                {
                    menuItems.map(({ name, url }) => (
                        <AbstractMenuItem className="cursor-pointer hover:underline">
                            <AbstractLocalLink href={url}>
                                {name}
                            </AbstractLocalLink>
                        </AbstractMenuItem>
                    ))
                }
            </AbstractMenu>
        </AbstractNavbar>
    </AbstractHeader>

    <AbstractMain className="main">
        <AbstractNoscript className="main__noscript">
            For full functionality of this site it is necessary to <AbstractTextDecoration
                className="font-bold"
            >
                enable JavaScript
            </AbstractTextDecoration>.
        </AbstractNoscript>

        <slot />
    </AbstractMain>

    <AbstractFooter>
        <AbstractParagraph className="w-full text-center italic"
            >Copyright © {new Date().getUTCFullYear()}{" "}
            Madliani Studio. All Rights Reserved.</AbstractParagraph
        >

        <AbstractBloc
            className="flex w-full flex-row flex-nowrap items-center justify-center gap-3"
        >
            <AbstractGlobalLink
                href="https://facebook.com/"
                title="Facebook link"
            />
            <AbstractGlobalLink
                href="https://instagram.com/"
                title="Instagram link"
            />
            <AbstractGlobalLink
                href="https://tiktok.com/"
                title="TikTok link"
            />
        </AbstractBloc>
    </AbstractFooter>
</AbstractLayout>

<script>
    document.addEventListener("astro:page-load", () => {
        const hamburger = document.getElementById("hamburger")
        const mobileMenu = document.getElementById("mobile-menu")

        if (hamburger !== null && mobileMenu !== null) {
            const toggleHamburgerMenu = () => {
                hamburger.classList.toggle("tham-active")

                mobileMenu.classList.toggle("hidden")
                mobileMenu.classList.toggle("flex")
            }

            hamburger.addEventListener("click", toggleHamburgerMenu)
            mobileMenu.addEventListener("click", toggleHamburgerMenu)

            for (
                let index = 0;
                index <= (mobileMenu.children.length ?? 0) - 1;
                index++
            ) {
                const menuItem = mobileMenu.children.item(index)

                if (menuItem !== null) {
                    menuItem.addEventListener("click", toggleHamburgerMenu)
                }
            }
        }
    })
</script>
