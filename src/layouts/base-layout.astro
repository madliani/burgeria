---
import Metadata from "@blocs/metadata.astro"
import Navbar, { type MenuItem } from "@blocs/navbar.astro"
import Noscript from "@blocs/noscript.astro"
import AbstractFooter from "@components/abstract-footer.astro"
import AbstractHeader from "@components/abstract-header.astro"
import AbstractLayout from "@components/abstract-layout.astro"
import AbstractMain from "@components/abstract-main.astro"
import MetadataConfig from "@configurations/metadata.config.json"
import "@styles/global.tw.css"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props

const menuItems: MenuItem[] = [
    { name: "Home", url: "/" },
    { name: "Menu", url: "/" }
]
---

<AbstractLayout lang={MetadataConfig.language}>
    <Fragment slot="head">
        <Metadata description={description} title={title} />

        <ClientRouter />
    </Fragment>

    <AbstractHeader>
        <Noscript slot="noscript" />

        <Navbar menuItems={menuItems}>
            <a href="/" slot="logo"
                ><img
                    alt="Burgeria logo"
                    src="/icons/burgeria-logo.png"
                    width="128px"
                /></a
            >
        </Navbar>
    </AbstractHeader>

    <AbstractMain>
        <slot />
    </AbstractMain>

    <AbstractFooter>
        <slot name="logo" />

        <p class="w-full text-center italic"
            >Copyright © {new Date().getUTCFullYear()}{" "}
            Madliani Studio. All Rights Reserved.</p
        >

        <section
            class="flex w-full flex-row flex-nowrap items-center justify-center gap-3"
        >
            <a
                aria-label="Facebook link"
                class="cursor-pointer"
                href="https://facebook.com/"
                referrerpolicy="no-referrer"
                rel="noopener"
                target="_blank"
                title="Facebook link"
            >
                <i class="fa-brands fa-facebook"></i>
            </a>

            <a
                aria-label="Instagram link"
                class="cursor-pointer"
                href="https://instagram.com/"
                referrerpolicy="no-referrer"
                rel="noopener"
                target="_blank"
                title="Instagram link"
            >
                <i class="fa-brands fa-instagram"></i>
            </a>

            <a
                aria-label="TikTok link"
                class="cursor-pointer"
                href="https://tiktok.com/"
                referrerpolicy="no-referrer"
                rel="noopener"
                target="_blank"
                title="TikTok link"
            >
                <i class="fa-brands fa-tiktok"></i>
            </a>
        </section>
    </AbstractFooter>
</AbstractLayout>
