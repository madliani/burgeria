---
import Metadata from "@blocs/metadata.astro"
import Noscript from "@blocs/noscript.astro"
import AbstractFooter from "@components/abstract-footer.astro"
import AbstractHeader from "@components/abstract-header.astro"
import AbstractLayout from "@components/abstract-layout.astro"
import AbstractMain from "@components/abstract-main.astro"
import AbstractNavbar from "@components/abstract-navbar.astro"
import MetadataConfig from "@configurations/metadata.config.json"
import "@styles/global.tw.css"
import { ClientRouter } from "astro:transitions"

interface MenuItem {
    name: string
    url: string
}

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props

const menuItems: MenuItem[] = [
    { name: "Home", url: "/" },
    { name: "Menu", url: "/" }
]
---

<AbstractLayout className="layout" lang={MetadataConfig.language}>
    <Fragment slot="head">
        <Metadata description={description} title={title} />

        <ClientRouter />
    </Fragment>

    <AbstractHeader className="header">
        <Noscript slot="noscript" />

        <a href="/"
            ><img
                alt="Burgeria logo"
                src="/icons/burgeria-logo.png"
                width="128px"
            /></a
        >

        <AbstractNavbar
            className="flex w-full flex-row flex-nowrap items-center justify-end align-middle text-xl"
        >
            <ul
                class="hidden sm:flex sm:flex-row sm:flex-nowrap sm:items-center sm:justify-evenly sm:gap-7 sm:align-middle"
            >
                {
                    menuItems.map(({ name, url }) => (
                        <li class="cursor-pointer hover:underline">
                            <a href={url}>{name}</a>
                        </li>
                    ))
                }
            </ul>

            <div
                class="tham-w-6 tham-e-squeeze z-10 tham sm:hidden"
                id="hamburger"
            >
                <div class="tham-box">
                    <div class="tham-inner"></div>
                </div>
            </div>

            <ul
                class="absolute top-0 right-0 bottom-0 left-0 hidden w-full flex-col flex-nowrap items-start justify-start gap-3 bg-white bg-[url('/images/prebuiltui-gradient-background.svg')] bg-cover px-3 py-5 align-middle"
                id="mobile-menu"
            >
                {
                    menuItems.map(({ name, url }) => (
                        <li class="cursor-pointer hover:underline">
                            <a href={url}>{name}</a>
                        </li>
                    ))
                }
            </ul>
        </AbstractNavbar>
    </AbstractHeader>

    <AbstractMain className="main">
        <slot />
    </AbstractMain>

    <AbstractFooter>
        <slot name="logo" />

        <p class="w-full text-center italic"
            >Copyright © {new Date().getUTCFullYear()}{" "}
            Madliani Studio. All Rights Reserved.</p
        >

        <section
            class="flex w-full flex-row flex-nowrap items-center justify-center gap-3"
        >
            <a
                aria-label="Facebook link"
                class="cursor-pointer"
                href="https://facebook.com/"
                referrerpolicy="no-referrer"
                rel="noopener"
                target="_blank"
                title="Facebook link"
            >
                <i class="fa-brands fa-facebook"></i>
            </a>

            <a
                aria-label="Instagram link"
                class="cursor-pointer"
                href="https://instagram.com/"
                referrerpolicy="no-referrer"
                rel="noopener"
                target="_blank"
                title="Instagram link"
            >
                <i class="fa-brands fa-instagram"></i>
            </a>

            <a
                aria-label="TikTok link"
                class="cursor-pointer"
                href="https://tiktok.com/"
                referrerpolicy="no-referrer"
                rel="noopener"
                target="_blank"
                title="TikTok link"
            >
                <i class="fa-brands fa-tiktok"></i>
            </a>
        </section>
    </AbstractFooter>
</AbstractLayout>

<script>
    document.addEventListener("astro:page-load", () => {
        const hamburger = document.getElementById("hamburger")
        const mobileMenu = document.getElementById("mobile-menu")

        const toggleHamburgerMenu = () => {
            hamburger?.classList.toggle("tham-active")

            mobileMenu?.classList.toggle("hidden")
            mobileMenu?.classList.toggle("flex")
        }

        hamburger?.addEventListener("click", toggleHamburgerMenu)
        mobileMenu?.addEventListener("click", toggleHamburgerMenu)

        for (
            let index = 0;
            index <= (mobileMenu?.children.length ?? 0) - 1;
            index++
        ) {
            const menuItem = mobileMenu?.children.item(index)

            menuItem?.addEventListener("click", toggleHamburgerMenu)
        }
    })
</script>
