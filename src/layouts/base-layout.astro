---
import Footer from "@blocs/footer.astro"
import Header from "@blocs/header.astro"
import Main from "@blocs/main.astro"
import Metadata from "@blocs/metadata.astro"
import MetadataConfig from "@configurations/metadata.config.json"
import "@styles/global.tw.css"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.main.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body class="body">
        <Header className="header">
            <slot name="header-noscript" />

            <slot name="header-content" />
        </Header>

        <Main class="main">
            <slot />
        </Main>

        <Footer className="footer">
            <slot name="footer-content" />
        </Footer>
    </body></html
>
