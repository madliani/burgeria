---
import Footer from "@blocs/footer.astro"
import Header from "@blocs/header.astro"
import Main from "@blocs/main.astro"
import Metadata from "@blocs/metadata.astro"
import AbstractLayout from "@components/abstract-layout.astro"
import MetadataConfig from "@configurations/metadata.config.json"
import "@styles/global.tw.css"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props
---

<AbstractLayout lang={MetadataConfig.main.language}>
    <Fragment slot="head">
        <Metadata description={description} title={title} />

        <ClientRouter />
    </Fragment>

    <Header slot="header" />

    <Main class="main">
        <slot />
    </Main>

    <Footer
        authorName="Madliani Studio"
        facebookUrl="https://facebook.com/"
        instagramUrl="https://instagram.com/"
        slot="footer"
        tiktokUrl="https://tiktok.com/"
    />
</AbstractLayout>
