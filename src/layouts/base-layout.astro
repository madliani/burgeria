---
import Footer from "@blocs/footer.astro"
import Header from "@blocs/header.astro"
import Main from "@blocs/main.astro"
import Metadata from "@blocs/metadata.astro"
import Noscript from "@blocs/noscript.astro"
import MetadataConfig from "@configurations/metadata.config.json"
import "@styles/global.tw.css"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    footerStyles?: string
    headerStyles?: string
    mainStyles?: string
    title?: string
}

const {
    description = "",
    footerStyles = "",
    headerStyles = "",
    mainStyles = "",
    title = ""
} = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.main.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body
        class="bg-[url('/images/prebuiltui-gradient-background.svg')] bg-cover"
    >
        <Noscript />

        <Header className={headerStyles}>
            <slot name="header-content" />
        </Header>

        <Main class={mainStyles}>
            <slot />
        </Main>

        <Footer className={footerStyles}>
            <slot name="footer-content" />
        </Footer>
    </body></html
>
