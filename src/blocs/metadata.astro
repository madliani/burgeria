---
import MetadataConfig from "@configurations/metadata.config.json"

interface Props {
    description?: string
    title?: string
}

const mainMetadata = {
    atiPath: MetadataConfig.main.ati_path,
    author: MetadataConfig.main.author,
    basePath: MetadataConfig.main.base_path,
    canonicalURL: new URL(Astro.url.pathname, Astro.site),
    charset: MetadataConfig.main.charset,
    csp: MetadataConfig.main.csp,
    description: Astro.props.description || MetadataConfig.main.description,
    faviconPath: MetadataConfig.main.favicon_path,
    faviconSVGPath: MetadataConfig.main.favicon_svg_path,
    generator: Astro.generator,
    isIndexable: MetadataConfig.main.is_indexable,
    isSupportedIE: MetadataConfig.main.is_supported_ie,
    keywords: MetadataConfig.main.keywords,
    sitemapPath: MetadataConfig.main.sitemap_path,
    themeColor: MetadataConfig.main.theme_color,
    title: Astro.props.title
        ? `${Astro.props.title} | ${MetadataConfig.main.title}`
        : MetadataConfig.main.title,
    viewport: MetadataConfig.main.viewport
}

const openGraphMetadata = {
    description: mainMetadata.description,
    imagePath: MetadataConfig.open_graph.image_path,
    locale: MetadataConfig.open_graph.locale,
    siteName: MetadataConfig.open_graph.site_name,
    title: mainMetadata.title,
    type: MetadataConfig.open_graph.type,
    url: Astro.url
}

const twitterCardMetadata = {
    card: MetadataConfig.twitter_card.card,
    description: mainMetadata.description,
    imagePath: MetadataConfig.twitter_card.image_path,
    title: mainMetadata.title,
    url: Astro.url
}
---

<meta charset={mainMetadata.charset} />

<meta content={mainMetadata.author} name="author" />
<meta content={mainMetadata.description} name="description" />
<meta content={mainMetadata.generator} name="generator" />
<meta content={mainMetadata.keywords} name="keywords" />
<meta content={mainMetadata.themeColor} name="theme-color" />
<meta content={mainMetadata.title} name="title" />
<meta content={mainMetadata.viewport} name="viewport" />
{
    mainMetadata.isIndexable ? (
        <meta content="follow, index" name="robots" />
    ) : (
        <meta content="nofollow, noindex" name="robots" />
    )
}

<meta content={mainMetadata.csp} http-equiv="content-security-policy" />
{
    mainMetadata.isSupportedIE && (
        <meta content="ie=edge" http-equiv="X-UA-Compatible" />
    )
}

<base href={mainMetadata.basePath} />

<link href={mainMetadata.canonicalURL} rel="canonical" />
<link href={mainMetadata.sitemapPath} rel="sitemap" />

<link href={mainMetadata.faviconPath} rel="icon" type="image/x-icon" />
<link href={mainMetadata.faviconSVGPath} rel="icon" type="image/svg+xml" />
<link href={mainMetadata.atiPath} rel="apple-touch-icon" type="image/png" />

<title>{mainMetadata.title}</title>

<!-- Open Graph -->
<meta content={openGraphMetadata.description} property="og:description" />
<meta content={openGraphMetadata.imagePath} property="og:image" />
<meta content={openGraphMetadata.locale} property="og:locale" />
<meta content={openGraphMetadata.siteName} property="og:site_name" />
<meta content={openGraphMetadata.title} property="og:title" />
<meta content={openGraphMetadata.type} property="og:type" />
<meta content={openGraphMetadata.url} property="og:url" />

<!-- Twitter Card -->
<meta content={twitterCardMetadata.card} property="twitter:card" />
<meta
    content={twitterCardMetadata.description}
    property="twitter:description"
/>
<meta content={twitterCardMetadata.imagePath} name="twitter:image" />
<meta content={twitterCardMetadata.title} property="twitter:title" />
<meta content={twitterCardMetadata.url} property="twitter:url" />
