---
import AbstractGlobalLink from "@components/abstract-global-link.astro"
import AbstractIcon from "@components/abstract-icon.astro"

export type Social = "Facebook" | "Instagram" | "TikTok"

interface Props {
    href: string
    social: Social
}

const { href, social } = Astro.props
---

{
    social === "Facebook" ? (
        <AbstractGlobalLink
            className="cursor-pointer"
            href={href}
            newTab={true}
            title="Facebook link"
        >
            <AbstractIcon className="fa-brands fa-facebook" />
        </AbstractGlobalLink>
    ) : social === "Instagram" ? (
        <AbstractGlobalLink
            className="cursor-pointer"
            href={href}
            newTab={true}
            title="Instagram link"
        >
            <AbstractIcon className="fa-brands fa-instagram" />
        </AbstractGlobalLink>
    ) : social === "TikTok" ? (
        <AbstractGlobalLink
            className="cursor-pointer"
            href={href}
            newTab={true}
            title="TikTok link"
        >
            <AbstractIcon className="fa-brands fa-tiktok" />
        </AbstractGlobalLink>
    ) : (
        <Fragment />
    )
}
