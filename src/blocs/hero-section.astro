---
interface Props {
    btnText: string
    subtitle: string
    title: string
}

const { btnText, subtitle, title } = Astro.props
---

<section
    class="container flex flex-col flex-nowrap items-center justify-center gap-5 text-center"
>
    <h1 class="text-5xl font-bold sm:text-7xl">
        {title}
    </h1>

    <h2 class="text-3xl sm:text-5xl">
        {subtitle}
    </h2>

    <button
        class="cursor-pointer rounded-full bg-[#FFD700] px-5 py-3 text-xl font-semibold text-white active:scale-98"
    >
        <a href="/">{btnText}</a>
    </button>
</section>
