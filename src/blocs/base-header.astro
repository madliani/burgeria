---
import type MenuItem from "@components/types/menu-item"

import AbstractBloc from "@components/abstract-bloc.astro"
import AbstractButton from "@components/abstract-button.astro"
import AbstractHeader from "@components/abstract-header.astro"
import AbstractLocalLink from "@components/abstract-local-link.astro"
import AbstractLogo from "@components/abstract-logo.astro"
import AbstractMenuItem from "@components/abstract-menu-item.astro"
import AbstractMenu from "@components/abstract-menu.astro"
import AbstractNavbar from "@components/abstract-navbar.astro"
import AbstractTextDecoration from "@components/abstract-text-decoration.astro"

const menuItems: readonly MenuItem[] = [{ name: "Home", url: "/" }]
---

<AbstractHeader className="base-header">
    <AbstractBloc className="base-header__logo-container">
        <AbstractLocalLink href="/">
            <AbstractLogo
                alt="Burgeria logo"
                className="base-header__logo"
                src="/icons/burgeria-logo.png"
            /></AbstractLocalLink
        >
    </AbstractBloc>

    <AbstractNavbar className="base-header__navbar">
        <AbstractMenu className="base-header__menu">
            {
                menuItems.map(({ name, url }) => (
                    <AbstractMenuItem className="base-header__menu-item">
                        <AbstractLocalLink href={url}>{name}</AbstractLocalLink>
                    </AbstractMenuItem>
                ))
            }
        </AbstractMenu>

        <AbstractButton
            className="base-header__hamburger hamburger hamburger--default"
            dataset={{ id: "hamburger" }}
            type="button"
        >
            <AbstractBloc className="inner">
                <AbstractTextDecoration className="bar" />

                <AbstractTextDecoration className="bar" />

                <AbstractTextDecoration className="bar" />
            </AbstractBloc>
        </AbstractButton>

        <AbstractMenu
            className="base-header__mobile-menu"
            dataset={{ id: "mobile-menu" }}
        >
            {
                menuItems.map(({ name, url }) => (
                    <AbstractMenuItem className="base-header__mobile-menu-item">
                        <AbstractLocalLink href={url}>{name}</AbstractLocalLink>
                    </AbstractMenuItem>
                ))
            }
        </AbstractMenu>
    </AbstractNavbar>
</AbstractHeader>

<script>
    const onHamburgerClick = () => {
        const hamburger = document.querySelector("[data-id='hamburger']")
        const mobileMenu = document.querySelector("[data-id='mobile-menu']")

        if (hamburger !== null && mobileMenu !== null) {
            const toggleHamburgerMenu = () => {
                hamburger.classList.toggle("active")

                mobileMenu.classList.toggle(
                    "base-header__mobile-menu--unhidden"
                )
            }

            hamburger.addEventListener("click", toggleHamburgerMenu)
            mobileMenu.addEventListener("click", toggleHamburgerMenu)

            for (
                let index = 0;
                index <= (mobileMenu.children.length ?? 0) - 1;
                index++
            ) {
                const menuItem = mobileMenu.children.item(index)

                if (menuItem !== null) {
                    menuItem.addEventListener("click", toggleHamburgerMenu)
                }
            }
        }
    }

    document.addEventListener("astro:page-load", () => {
        onHamburgerClick()
    })
</script>
